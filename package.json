{
  "name": "history-heatmap",
  "private": true,
  "version": "1.8.0",
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "prepare": "simple-git-hooks",
    "fallow": "fallow audit --base HEAD",
    "fallow:all": "fallow --fail-on-issues",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmark:history": "node scripts/benchmark-history.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "check": "npm run check:types && npm run check:svelte",
    "check:versions": "node scripts/check-versions.mjs",
    "check:types": "node node_modules/typescript-native/bin/tsc -p tsconfig.app.json && node node_modules/typescript-native/bin/tsc -p tsconfig.node.json",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.app.json --diagnostic-sources js,svelte",
    "lint": "npm run lint:scripts && npm run lint:styles",
    "lint:scripts": "oxlint --max-warnings 0 .",
    "lint:styles": "stylelint \"src/**/*.{css,svelte}\" --max-warnings 0",
    "lint:fix": "npm run lint:scripts -- --fix && npm run lint:styles -- --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "simple-git-hooks": {
    "pre-commit": "npm run lint && npm run format:check && npm run fallow -- --quiet --gate-marker pre-commit",
    "pre-push": "npm run check && npm test"
  },
  "dependencies": {
    "@tanstack/svelte-virtual": "^3.13.51"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "fallow": "3.39.0",
    "jsdom": "^30.1.3",
    "lightningcss": "^1.33.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "playwright-core": "^1.64.1",
    "postcss-html": "^2.0.0",
    "simple-git-hooks": "^2.14.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "~6.0.3",
    "typescript-native": "npm:typescript@7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
