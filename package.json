{
  "name": "history-heatmap",
  "private": true,
  "version": "1.2.1",
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "prepare": "simple-git-hooks",
    "fallow": "fallow audit --base HEAD",
    "fallow:all": "fallow --fail-on-issues",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmark:history": "node scripts/benchmark-history.mjs",
    "check": "npm run check:types && npm run check:svelte",
    "check:types": "tsgo -p tsconfig.app.json && tsgo -p tsconfig.node.json",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.app.json --diagnostic-sources js,svelte",
    "lint": "oxlint --max-warnings 0 .",
    "lint:fix": "npm run lint -- --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "simple-git-hooks": {
    "pre-commit": "npm run fallow -- --quiet --gate-marker pre-commit"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/chrome": "^0.2.9",
    "@types/node": "^26.5.1",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "fallow": "3.25.0",
    "jsdom": "^30.0.1",
    "lightningcss": "^1.33.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "simple-git-hooks": "^2.14.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
