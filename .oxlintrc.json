{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "overrides": [
    {
      // Test helpers stay next to the describe block that uses them.
      "files": ["**/*.test.ts"],
      "rules": { "unicorn/consistent-function-scoping": "off" }
    }
  ],
  "ignorePatterns": ["dist/**", "dist-ssr/**", ".fallow/**"]
}
